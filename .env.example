# ==============================================================================
# MeetingOS AI Service Configuration
# ==============================================================================

# Environment & Server
ENVIRONMENT=development
WORKER_PORT=8001

# Message Broker (RabbitMQ)
RABBITMQ_URL=amqp://meetingos:meetingos_pass@localhost:5672

# Database (PostgreSQL)
DATABASE_URL=postgresql://meetingos:meetingos_pass@localhost:5432/meetingos?schema=public

# AI Provider Configuration
AI_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.0-flash

# Google Gemini API Key (Add your key below)
GEMINI_API_KEY=
