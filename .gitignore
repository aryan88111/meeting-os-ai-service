# AI Service (Python FastAPI & Worker) Gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.Python

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment Variables & Secrets
.env
.env.*
.env.local
!.env.example

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Playwright & Document Export Temp Dumps
playwright-report/
test-results/
*.pdf
*.docx
temp/
tmp/

# OS Metadata
.DS_Store
Thumbs.db
